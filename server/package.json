{
  "name": "schedai-server",
  "version": "1.0.0",
  "description": "Backend server for SchedAI application",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest --verbose --forceExit --detectOpenHandles",
    "test:unit": "jest --verbose --testPathPattern=tests/unit",
    "test:integration": "jest --verbose --testPathPattern=tests/integration --forceExit --detectOpenHandles",
    "test:report": "jest --verbose --forceExit --detectOpenHandles"
  },
  "keywords": [
    "schedai",
    "scheduling",
    "education"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.23.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "jest-html-reporter": "^3.10.2",
    "mongodb-memory-server": "^10.0.0",
    "nodemon": "^3.0.1",
    "supertest": "^7.0.0"
  }
}
